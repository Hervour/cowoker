{
  "name": "cowoker",
  "version": "0.1.0",
  "private": true,
  "description": "Remote-control Codex from official WeCom and QQ bot channels.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:test && node --test \".test-dist/test/*.test.js\"",
    "start": "node dist/index.js",
    "dev": "npm run build && node --watch dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "codex",
    "qq-bot",
    "wecom",
    "automation"
  ],
  "license": "MIT",
  "dependencies": {
    "@openai/codex-sdk": "^0.159.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
